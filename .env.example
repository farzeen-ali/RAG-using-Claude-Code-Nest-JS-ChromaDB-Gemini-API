# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Gemini (Google GenAI)
# Get a key from https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# ChromaDB
# Run a local server first, see README for instructions.
# ---------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION_NAME=knowledge_base

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Retrieval (hybrid search: semantic vector search + BM25 keyword search)
# CANDIDATE_K = how many results each of vector/BM25 search fetch before
#               merging; TOP_K = how many reranked chunks go to Gemini.
# ---------------------------------------------------------------------------
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------------
# Evaluation (Ragas-inspired quality scoring — see README)
# Path is relative to the project root unless absolute.
# ---------------------------------------------------------------------------
EVALUATION_DATASET_PATH=evaluation-dataset.json

# ---------------------------------------------------------------------------
# Redis (short-term chat memory — see README)
# REDIS_PASSWORD may be left empty for a local Redis with no auth.
# TTL_SECONDS = how long an inactive session's memory is kept (1800 = 30 min).
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=1800
